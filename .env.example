# DaVinci PiloT Environment Configuration
APP_NAME="Davinci PiloT"
APP_ENV=development
LOG_LEVEL=DEBUG

# DaVinci Resolve Scripting API Settings
RESOLVE_SCRIPT_API="C:\Program Files\Blackmagic Design\DaVinci Resolve\Developer\Scripting"
RESOLVE_SCRIPT_LIB="C:\Program Files\Blackmagic Design\DaVinci Resolve\fusionscript.dll"
PYTHONPATH="%PYTHONPATH%;C:\Program Files\Blackmagic Design\DaVinci Resolve\Developer\Scripting\Modules"

# Primary AI Provider: NVIDIA NIM (build.nvidia.com)
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL="https://integrate.api.nvidia.com/v1"
DEFAULT_AI_PROVIDER=nvidia_nim

# Specialized NVIDIA NIM Multi-Agent Models
NVIDIA_MODEL_MASTER_PLANNER="GLM-5.2"
NVIDIA_MODEL_VISION="MiniMax M3"
NVIDIA_MODEL_REASONING="Nemotron-3 Ultra 550B"
NVIDIA_MODEL_OCR="Nemotron OCR v2"
NVIDIA_MODEL_ASR="Nemotron ASR Streaming"
NVIDIA_MODEL_EMBEDDINGS="Nemotron Embed 1B"
